{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sinceai.ai/schemas/dna-2026/v2/case.schema.json",
  "title": "DNA Digital Security Assistant v2 - dev case (with ground truth and simulation)",
  "type": "object",
  "required": [
    "case_id",
    "split",
    "version",
    "journey",
    "audience",
    "locale",
    "language",
    "persona",
    "entry_point",
    "user_identified",
    "opening_message",
    "signals",
    "signal_availability",
    "consent",
    "tags",
    "difficulty",
    "scenario_family",
    "title",
    "holdout_family",
    "ground_truth",
    "simulation"
  ],
  "properties": {
    "case_id": {
      "type": "string"
    },
    "split": {
      "enum": [
        "dev",
        "test"
      ]
    },
    "version": {
      "type": "string"
    },
    "journey": {
      "enum": [
        "suspicious_message",
        "clicked_link",
        "suspicious_call",
        "breach_notice",
        "smb_incident"
      ]
    },
    "audience": {
      "enum": [
        "consumer",
        "small_business"
      ]
    },
    "locale": {
      "enum": [
        "fi-FI",
        "en-FI",
        "sv-FI"
      ]
    },
    "language": {
      "enum": [
        "fi",
        "en",
        "sv"
      ]
    },
    "persona": {
      "type": "object",
      "required": [
        "segment",
        "age_band",
        "tech_confidence",
        "emotional_state",
        "language"
      ]
    },
    "entry_point": {
      "enum": [
        "operator_app_chat",
        "business_portal_chat"
      ]
    },
    "user_identified": {
      "type": "boolean"
    },
    "opening_message": {
      "type": "string"
    },
    "signals": {
      "type": "object",
      "required": [
        "artifact",
        "link_check",
        "call_warning",
        "subscription",
        "device",
        "operator_account",
        "credential_exposure"
      ],
      "properties": {
        "artifact": {
          "type": "object",
          "required": [
            "type",
            "sender",
            "body",
            "links",
            "channel_language",
            "received_at"
          ],
          "properties": {
            "type": {
              "enum": [
                "sms",
                "email",
                "chat",
                "call",
                "letter",
                "social_ad",
                "push_notification",
                "user_report",
                "screen_note"
              ]
            },
            "channel_language": {
              "enum": [
                "fi",
                "en",
                "sv"
              ]
            },
            "sender": {
              "type": "string"
            },
            "body": {
              "type": "string"
            },
            "links": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "received_at": {
              "type": "string"
            },
            "thread_contains_genuine_messages_from_same_sender": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "link_check": {
          "type": [
            "object",
            "null",
            "string"
          ]
        },
        "call_warning": {
          "type": [
            "object",
            "null",
            "string"
          ]
        },
        "subscription": {
          "type": "object"
        },
        "device": {
          "type": "object"
        },
        "operator_account": {
          "type": "object"
        },
        "credential_exposure": {
          "type": [
            "object",
            "null",
            "string"
          ]
        },
        "business": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "signal_availability": {
      "type": "object"
    },
    "consent": {
      "type": "object",
      "required": [
        "requires_consent",
        "pre_granted"
      ],
      "properties": {
        "requires_consent": {
          "type": "array",
          "items": {
            "enum": [
              "artifact",
              "link_check",
              "call_warning",
              "user_call_notes",
              "subscription.products",
              "subscription.recent_events",
              "subscription.network_status",
              "device.summary",
              "device.recent_app_installs",
              "device.security_findings",
              "operator_account.recent_logins",
              "credential_exposure",
              "business.profile",
              "business.staff_accounts"
            ]
          }
        },
        "pre_granted": {
          "type": "array",
          "items": {
            "enum": [
              "artifact",
              "link_check",
              "call_warning",
              "user_call_notes",
              "subscription.products",
              "subscription.recent_events",
              "subscription.network_status",
              "device.summary",
              "device.recent_app_installs",
              "device.security_findings",
              "operator_account.recent_logins",
              "credential_exposure",
              "business.profile",
              "business.staff_accounts"
            ]
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "difficulty": {
      "enum": [
        "easy",
        "medium",
        "hard"
      ]
    },
    "scenario_family": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "holdout_family": {
      "type": "boolean"
    },
    "ground_truth": {
      "type": "object",
      "required": [
        "risk_level",
        "urgency",
        "primary_action",
        "acceptable_actions",
        "escalation",
        "required_steps",
        "must_not",
        "must_ask_topics",
        "single_turn",
        "is_benign_control",
        "reference_answer_fi",
        "reference_answer_en"
      ],
      "properties": {
        "risk_level": {
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "urgency": {
          "enum": [
            "none",
            "routine",
            "today",
            "immediate"
          ]
        },
        "primary_action": {
          "enum": [
            "no_action_needed",
            "do_not_interact_and_delete",
            "verify_via_official_channel",
            "contact_operator_support",
            "change_password_and_enable_mfa",
            "isolate_device_and_scan",
            "contact_bank_and_block_cards",
            "report_to_authority",
            "escalate_to_human",
            "decline_out_of_scope"
          ]
        },
        "acceptable_actions": {
          "type": "array",
          "items": {
            "enum": [
              "no_action_needed",
              "do_not_interact_and_delete",
              "verify_via_official_channel",
              "contact_operator_support",
              "change_password_and_enable_mfa",
              "isolate_device_and_scan",
              "contact_bank_and_block_cards",
              "report_to_authority",
              "escalate_to_human",
              "decline_out_of_scope"
            ]
          }
        },
        "escalation": {
          "type": "object",
          "required": [
            "required",
            "target",
            "acceptable_targets"
          ],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "target": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "operator_support_agent",
                "security_specialist",
                "business_security_support",
                "human_advisor",
                null
              ]
            },
            "acceptable_targets": {
              "type": "array",
              "items": {
                "enum": [
                  "operator_support_agent",
                  "security_specialist",
                  "business_security_support",
                  "human_advisor"
                ]
              }
            }
          }
        },
        "external_contacts": {
          "type": "array",
          "items": {
            "enum": [
              "bank",
              "police",
              "ncsc"
            ]
          }
        },
        "required_steps": {
          "type": "array",
          "items": {
            "enum": [
              "dont_open_link",
              "dont_pay_or_transfer",
              "dont_reply",
              "delete_or_report_message",
              "verify_official_channel",
              "verify_out_of_band",
              "contact_bank_now",
              "block_card",
              "change_password",
              "enable_mfa",
              "use_trusted_device",
              "check_password_reuse",
              "review_sessions",
              "dont_approve_prompts",
              "dont_share_codes",
              "disconnect_device",
              "remove_app_or_profile",
              "get_device_checked",
              "avoid_banking_on_device",
              "contact_operator",
              "lock_subscription",
              "report_police",
              "report_cyber_authority",
              "keep_evidence",
              "hang_up_dont_call_back",
              "two_person_approval",
              "revoke_access",
              "check_forwarding_rules",
              "inform_staff",
              "dont_open_attachment",
              "secure_router",
              "explain_benign",
              "seek_support_org",
              "plan_before_removing",
              "notify_data_protection",
              "decline_request",
              "check_statements",
              "update_device"
            ]
          }
        },
        "optional_steps": {
          "type": "array",
          "items": {
            "enum": [
              "dont_open_link",
              "dont_pay_or_transfer",
              "dont_reply",
              "delete_or_report_message",
              "verify_official_channel",
              "verify_out_of_band",
              "contact_bank_now",
              "block_card",
              "change_password",
              "enable_mfa",
              "use_trusted_device",
              "check_password_reuse",
              "review_sessions",
              "dont_approve_prompts",
              "dont_share_codes",
              "disconnect_device",
              "remove_app_or_profile",
              "get_device_checked",
              "avoid_banking_on_device",
              "contact_operator",
              "lock_subscription",
              "report_police",
              "report_cyber_authority",
              "keep_evidence",
              "hang_up_dont_call_back",
              "two_person_approval",
              "revoke_access",
              "check_forwarding_rules",
              "inform_staff",
              "dont_open_attachment",
              "secure_router",
              "explain_benign",
              "seek_support_org",
              "plan_before_removing",
              "notify_data_protection",
              "decline_request",
              "check_statements",
              "update_device"
            ]
          }
        },
        "must_not": {
          "type": "array",
          "items": {
            "enum": [
              "pay_the_fee",
              "open_link_to_check",
              "log_in_via_link",
              "call_number_in_message",
              "share_code",
              "approve_prompt",
              "install_from_link",
              "give_remote_access",
              "keep_using_device",
              "thread_proves_genuine",
              "false_reassurance",
              "transfer_money",
              "safe_account",
              "update_bank_details",
              "wait_and_see",
              "network_glitch",
              "claim_compromised",
              "block_card_unneeded",
              "hack_back",
              "remove_monitoring_immediately",
              "disable_security",
              "open_attachment",
              "reply_to_sender"
            ]
          }
        },
        "guidance_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "must_ask_topics": {
          "type": "array",
          "items": {
            "enum": [
              "credentials_entered",
              "card_details_entered",
              "code_shared",
              "money_transferred",
              "app_installed",
              "remote_access_given",
              "link_details",
              "call_details",
              "self_initiated",
              "device_behaviour",
              "signal_lost",
              "account_affected",
              "password_reused",
              "business_access",
              "payment_status",
              "user_safety",
              "time_of_event",
              "message_content"
            ]
          }
        },
        "should_ask_topics": {
          "type": "array",
          "items": {
            "enum": [
              "credentials_entered",
              "card_details_entered",
              "code_shared",
              "money_transferred",
              "app_installed",
              "remote_access_given",
              "link_details",
              "call_details",
              "self_initiated",
              "device_behaviour",
              "signal_lost",
              "account_affected",
              "password_reused",
              "business_access",
              "payment_status",
              "user_safety",
              "time_of_event",
              "message_content"
            ]
          }
        },
        "relevant_topics": {
          "type": "array",
          "items": {
            "enum": [
              "credentials_entered",
              "card_details_entered",
              "code_shared",
              "money_transferred",
              "app_installed",
              "remote_access_given",
              "link_details",
              "call_details",
              "self_initiated",
              "device_behaviour",
              "signal_lost",
              "account_affected",
              "password_reused",
              "business_access",
              "payment_status",
              "user_safety",
              "time_of_event",
              "message_content"
            ]
          }
        },
        "single_turn": {
          "type": "object",
          "required": [
            "acceptable_actions",
            "must_ask_topics",
            "risk_range"
          ],
          "properties": {
            "acceptable_actions": {
              "type": "array",
              "items": {
                "enum": [
                  "no_action_needed",
                  "do_not_interact_and_delete",
                  "verify_via_official_channel",
                  "contact_operator_support",
                  "change_password_and_enable_mfa",
                  "isolate_device_and_scan",
                  "contact_bank_and_block_cards",
                  "report_to_authority",
                  "escalate_to_human",
                  "decline_out_of_scope"
                ]
              }
            },
            "must_ask_topics": {
              "type": "array",
              "items": {
                "enum": [
                  "credentials_entered",
                  "card_details_entered",
                  "code_shared",
                  "money_transferred",
                  "app_installed",
                  "remote_access_given",
                  "link_details",
                  "call_details",
                  "self_initiated",
                  "device_behaviour",
                  "signal_lost",
                  "account_affected",
                  "password_reused",
                  "business_access",
                  "payment_status",
                  "user_safety",
                  "time_of_event",
                  "message_content"
                ]
              }
            },
            "risk_range": {
              "type": "array",
              "items": {
                "enum": [
                  "none",
                  "low",
                  "medium",
                  "high",
                  "critical"
                ]
              }
            }
          }
        },
        "necessary_signals": {
          "type": "array",
          "items": {
            "enum": [
              "artifact",
              "link_check",
              "call_warning",
              "user_call_notes",
              "subscription.products",
              "subscription.recent_events",
              "subscription.network_status",
              "device.summary",
              "device.recent_app_installs",
              "device.security_findings",
              "operator_account.recent_logins",
              "credential_exposure",
              "business.profile",
              "business.staff_accounts"
            ]
          }
        },
        "is_benign_control": {
          "type": "boolean"
        },
        "twin_group": {
          "type": [
            "string",
            "null"
          ]
        },
        "branch": {
          "type": "string"
        },
        "rationale_en": {
          "type": "string"
        },
        "rationale_fi": {
          "type": "string"
        },
        "reference_answer_fi": {
          "type": "string"
        },
        "reference_answer_en": {
          "type": "string"
        }
      }
    },
    "simulation": {
      "type": "object",
      "required": [
        "language",
        "facts",
        "unknown_reply",
        "consent_policy",
        "max_assistant_turns"
      ],
      "properties": {
        "language": {
          "enum": [
            "fi",
            "en",
            "sv"
          ]
        },
        "facts": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "unknown_reply": {
          "type": "string"
        },
        "consent_policy": {
          "enum": [
            "grant",
            "refuse"
          ]
        },
        "consent_reply": {
          "type": "string"
        },
        "max_assistant_turns": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "additionalProperties": false
}
