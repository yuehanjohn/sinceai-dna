{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sinceai.ai/schemas/dna-2026/v2/submission.schema.json",
  "title": "DNA Digital Security Assistant v2 - one answer per line",
  "type": "object",
  "required": [
    "case_id",
    "risk_level",
    "primary_action",
    "advice_text",
    "escalation_required"
  ],
  "properties": {
    "case_id": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "single_turn",
        "multi_turn"
      ]
    },
    "risk_level": {
      "enum": [
        "none",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "urgency": {
      "enum": [
        "none",
        "routine",
        "today",
        "immediate"
      ]
    },
    "primary_action": {
      "enum": [
        "no_action_needed",
        "do_not_interact_and_delete",
        "verify_via_official_channel",
        "contact_operator_support",
        "change_password_and_enable_mfa",
        "isolate_device_and_scan",
        "contact_bank_and_block_cards",
        "report_to_authority",
        "escalate_to_human",
        "decline_out_of_scope"
      ]
    },
    "secondary_actions": {
      "type": "array",
      "items": {
        "enum": [
          "no_action_needed",
          "do_not_interact_and_delete",
          "verify_via_official_channel",
          "contact_operator_support",
          "change_password_and_enable_mfa",
          "isolate_device_and_scan",
          "contact_bank_and_block_cards",
          "report_to_authority",
          "escalate_to_human",
          "decline_out_of_scope"
        ]
      }
    },
    "advice_text": {
      "type": "string",
      "description": "Exactly what the user is shown, in the user's language."
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "questions_asked": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "question_topics": {
      "type": "array",
      "items": {
        "enum": [
          "credentials_entered",
          "card_details_entered",
          "code_shared",
          "money_transferred",
          "app_installed",
          "remote_access_given",
          "link_details",
          "call_details",
          "self_initiated",
          "device_behaviour",
          "signal_lost",
          "account_affected",
          "password_reused",
          "business_access",
          "payment_status",
          "user_safety",
          "time_of_event",
          "message_content"
        ]
      }
    },
    "escalation_required": {
      "type": "boolean"
    },
    "escalation_target": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "operator_support_agent",
        "security_specialist",
        "business_security_support",
        "human_advisor",
        null
      ]
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "signals_used": {
      "type": "array",
      "items": {
        "enum": [
          "artifact",
          "link_check",
          "call_warning",
          "user_call_notes",
          "subscription.products",
          "subscription.recent_events",
          "subscription.network_status",
          "device.summary",
          "device.recent_app_installs",
          "device.security_findings",
          "operator_account.recent_logins",
          "credential_exposure",
          "business.profile",
          "business.staff_accounts"
        ]
      }
    },
    "consent_requested_for": {
      "type": "array",
      "items": {
        "enum": [
          "artifact",
          "link_check",
          "call_warning",
          "user_call_notes",
          "subscription.products",
          "subscription.recent_events",
          "subscription.network_status",
          "device.summary",
          "device.recent_app_installs",
          "device.security_findings",
          "operator_account.recent_logins",
          "credential_exposure",
          "business.profile",
          "business.staff_accounts"
        ]
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "abstained": {
      "type": "boolean"
    },
    "transcript": {
      "type": "array"
    },
    "conversation": {
      "type": "object"
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
