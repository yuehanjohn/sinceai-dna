{
  "version": "2.0.1",
  "note": "Detection patterns are transparent heuristics, applied to advice_text + steps. Any pattern match counts.",
  "steps": {
    "dont_open_link": {
      "en": "Do not open the link.",
      "patterns": {
        "en": [
          "(do not|don't|never|avoid) (open|click|tap|use|follow)[^.]{0,30}link",
          "ignore the link",
          "leave the link",
          "(do not|don't|never) (log in|sign in|pay|enter|identify)[^.]{0,30}(through|via|using|from|on) (the |this |that )?link"
        ],
        "fi": [
          "(?:älä|äläkä|älkää) (avaa|klikkaa|paina|käytä|napauta|seuraa)[^.]{0,30}link",
          "linkki[^.]{0,20}(avaamatta|rauhaan)",
          "jätä linkki",
          "(?:älä|äläkä|älkää) (kirjaudu|tunnistaudu|maksa|syötä)[^.]{0,30}link"
        ],
        "sv": [
          "(öppna|klicka på|använd) inte[^.]{0,30}länk",
          "klicka aldrig"
        ]
      }
    },
    "dont_pay_or_transfer": {
      "en": "Do not pay or transfer money; hold the payment.",
      "patterns": {
        "en": [
          "(do not|don't|never) (pay|send money|transfer|make the payment|send the money)",
          "(do not|don't|never) (send|transfer|put|move)( any| the| more)? (money|funds)",
          "(hold|stop|pause|delay)[^.]{0,20}(payment|transfer)",
          "before (paying|you pay)"
        ],
        "fi": [
          "(?:älä|äläkä|älkää) (maksa|siirrä|lähetä rahaa|lähetä rahoja)",
          "(pysäytä|keskeytä|odota|pidätä)[^.]{0,30}(maksu|siirto)",
          "ennen maksamista",
          "ennen kuin (maksat|maksatte)",
          "älkää maksako",
          "(?:älä|äläkä) (laita|sijoita)[^.]{0,20}raha"
        ],
        "sv": [
          "betala inte",
          "för inte över",
          "(stoppa|vänta med)[^.]{0,20}(betalning|överföring)"
        ]
      }
    },
    "dont_reply": {
      "en": "Do not reply.",
      "patterns": {
        "en": [
          "(do not|don't|never) (reply|respond|answer|text back)"
        ],
        "fi": [
          "älä vastaa"
        ],
        "sv": [
          "svara inte"
        ]
      }
    },
    "delete_or_report_message": {
      "en": "Delete the message or report it as spam/scam.",
      "patterns": {
        "en": [
          "\\b(delete|report)\\b[^.]{0,40}(message|text|email|sms|spam|scam|junk|it)",
          "mark (it |the message )?as (spam|junk|scam)"
        ],
        "fi": [
          "(poista|ilmoita)[^.]{0,40}(viesti|roskapost|huijau|spam|sähköposti)",
          "merkitse[^.]{0,20}(roskapost|huijau)",
          "poista se"
        ],
        "sv": [
          "(radera|ta bort|rapportera)[^.]{0,30}(meddelande|skräppost|bedrägeri|det)"
        ]
      }
    },
    "verify_official_channel": {
      "en": "Check the matter in the official app or website, opened yourself.",
      "patterns": {
        "en": [
          "(official|own) (app|website|site|channel|number|online service)",
          "number (on|printed on) (the back of )?(your|the) card",
          "typ(e|ing) the (web )?address yourself",
          "log in (directly|yourself)",
          "(open|use) the [a-z]+'?s? (own )?app",
          "open (the|that) (service|app|site|website|online service) yourself",
          "(look up|find) [^.]{0,30}yourself",
          "(on|from) their own website"
        ],
        "fi": [
          "\\bom(a|i)\\w*\\s[^.]{0,15}(sovellu|verkkosivu|kanava|palvelu|numero|verkkopankki|sivu)",
          "virallise[^.]{0,15}(sovellu|verkkosivu|kanava|palvelu|numero)",
          "kortin (takana|kääntöpuolella)",
          "korti?ssa (olevaan|oleva|olevasta) numero",
          "kirjoit(a|amalla|tamalla) osoite itse",
          "kirjaudu (itse|suoraan)",
          "avaa[^.]{0,25}itse",
          "etsi[^.]{0,40}itse",
          "(numeroon|yhteystiedot), jo(ka|nka) löy(tyy|dät) itse"
        ],
        "sv": [
          "(egen|egna|egna|officiella?) (app|webbplats|kanal|nummer)",
          "logga in själv",
          "skriv adressen själv"
        ]
      }
    },
    "verify_out_of_band": {
